page{background:#f5f8fb;color:#1f2d3d}.page{padding:22rpx 32rpx}.top{display:flex;align-items:center;gap:20rpx;padding:30rpx 8rpx}.back{color:#1f2d3d;font-size:64rpx;line-height:40rpx}.kicker{color:#1677ff;font-size:20rpx;letter-spacing:4rpx}.title{margin-top:8rpx;font-size:42rpx;font-weight:700}.search{display:flex;align-items:center;gap:14rpx;height:80rpx;padding:0 24rpx;border-radius:16rpx;background:#fff;box-shadow:0 6rpx 18rpx rgba(31,45,61,.05)}.search text{color:#1677ff;font-size:38rpx}.search input{flex:1;font-size:26rpx}.list{margin-top:28rpx}.card{display:flex;overflow:hidden;margin-bottom:24rpx;border-radius:18rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(31,45,61,.06)}.card image,.cover{flex-shrink:0;width:230rpx;height:230rpx}.placeholder{display:flex;align-items:center;justify-content:center;padding:16rpx;box-sizing:border-box;color:#1677ff;background:#e7f1ff;font-weight:700}.body{padding:24rpx 20rpx}.name{font-size:31rpx;font-weight:700}.meta{margin-top:12rpx;color:#1677ff;font-size:23rpx}.desc{display:-webkit-box;overflow:hidden;margin-top:18rpx;color:#8795a2;font-size:23rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:3}.state{padding:100rpx 20rpx;color:#8795a2;text-align:center}.error{color:#e66b62}
