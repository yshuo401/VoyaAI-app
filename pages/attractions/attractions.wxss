page { background: #f6f8f7; color: #192522; }.page { padding: 34rpx 32rpx; }.top { display: flex; align-items: center; gap: 20rpx; padding: 30rpx 8rpx; }.back { color: #16805c; font-size: 64rpx; line-height: 40rpx; }.kicker { color: #16805c; font-size: 20rpx; letter-spacing: 4rpx; }.title { margin-top: 8rpx; font-size: 42rpx; font-weight: 700; }.search { display: flex; align-items: center; gap: 14rpx; height: 80rpx; padding: 0 24rpx; border-radius: 16rpx; background: #fff; }.search text { color: #16805c; font-size: 38rpx; }.search input { flex: 1; font-size: 26rpx; }.list { margin-top: 28rpx; }.card { display: flex; overflow: hidden; margin-bottom: 24rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(25,65,49,.06); }.card image,.cover { flex-shrink: 0; width: 230rpx; height: 230rpx; }.placeholder { display: flex; align-items: center; justify-content: center; padding: 16rpx; box-sizing: border-box; color: #16805c; background: #d9f2e7; font-weight: 700; }.body { padding: 24rpx 20rpx; }.name { font-size: 31rpx; font-weight: 700; }.meta { margin-top: 12rpx; color: #16805c; font-size: 23rpx; }.desc { display: -webkit-box; overflow: hidden; margin-top: 18rpx; color: #87938f; font-size: 23rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }.state { padding: 100rpx 20rpx; color: #87938f; text-align: center; }.error { color: #d05b4e; }
