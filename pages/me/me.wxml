<view class="page">
  <view class="header"><view class="kicker">VOYAAI ACCOUNT</view><view class="title">我的旅行</view></view>
  <view wx:if="{{!loggedIn}}" class="login-card"><view class="avatar placeholder">旅</view><view class="login-title">登录后开启完整体验</view><view class="login-subtitle">收藏景点、记录行程，随时回来继续探索</view><button class="login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="login">微信登录</button><view wx:if="{{error}}" class="error">{{error}}</view></view>
  <view wx:else class="profile-card"><view class="profile-row"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{user.avatarUrl}}" class="avatar" src="{{imageUrl(user.avatarUrl)}}" mode="aspectFill" /><view wx:else class="avatar placeholder">旅</view></button><view class="profile-main"><view class="nickname">{{user.nickname || '旅行者'}}</view><view class="profile-hint">点击头像更换头像</view></view></view><view class="form-label">昵称</view><input class="input" value="{{nickname}}" maxlength="100" bindinput="onNicknameInput" placeholder="请输入昵称" /><button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存资料</button><button class="logout-button" bindtap="logout">退出登录</button><view wx:if="{{error}}" class="error">{{error}}</view></view>
</view>
