<view class="page"><view class="profile-card"><view class="profile-row"><button class="avatar-button" wx:if="{{loggedIn}}" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{user.avatarUrl}}" class="avatar" src="{{imageUrl(user.avatarUrl)}}" mode="aspectFill" /><view wx:else class="avatar placeholder">旅</view></button><view wx:else class="avatar placeholder">旅</view><view class="profile-main"><view class="nickname">{{loggedIn ? (user.nickname || '旅行达人') : '旅行达人'}}</view><view class="profile-hint">{{loggedIn ? '点击头像更换头像' : '登录后开启完整旅行体验'}}</view></view><text class="edit">✎</text></view><view wx:if="{{!loggedIn}}"><button class="login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="login">微信登录</button></view><view wx:else class="profile-edit"><input class="input" value="{{nickname}}" maxlength="100" bindinput="onNicknameInput" placeholder="请输入昵称" /><button class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存资料</button></view><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="stats"><view><text>0</text><text>我的行程</text></view><view><text>0</text><text>我的收藏</text></view><view><text>0</text><text>浏览足迹</text></view></view><view class="menu"><view class="menu-item" bindtap="openTrips"><text class="menu-icon blue">▣</text><text>我的行程</text><text class="arrow">›</text></view><view class="menu-item"><text class="menu-icon orange">☆</text><text>我的收藏</text><text class="arrow">›</text></view><view class="menu-item"><text class="menu-icon green">◷</text><text>浏览历史</text><text class="arrow">›</text></view><view class="menu-item"><text class="menu-icon purple">⚙</text><text>设置</text><text class="arrow">›</text></view></view><button wx:if="{{loggedIn}}" class="logout-button" bindtap="logout">退出登录</button></view>
