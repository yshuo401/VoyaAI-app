page { background: #f6f8f7; color: #192522; }.page { min-height: 100vh; padding: 72rpx 40rpx; box-sizing: border-box; }.header { margin-bottom: 46rpx; }.kicker { color: #16805c; font-size: 22rpx; letter-spacing: 4rpx; font-weight: 700; }.title { margin-top: 16rpx; font-size: 52rpx; font-weight: 700; }.login-card,.profile-card { padding: 46rpx 36rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(25,65,49,.07); text-align: center; }.avatar-button { display: block; width: 136rpx; height: 136rpx; padding: 0; margin: 0; border-radius: 50%; background: transparent; }.avatar-button::after { border: 0; }.avatar { width: 136rpx; height: 136rpx; border-radius: 50%; }.placeholder { display: flex; align-items: center; justify-content: center; color: #16805c; background: #d9f2e7; font-size: 48rpx; font-weight: 700; }.login-title { margin-top: 30rpx; font-size: 34rpx; font-weight: 700; }.login-subtitle { margin-top: 16rpx; color: #899691; font-size: 25rpx; line-height: 1.5; }.login-button,.save-button { margin-top: 42rpx; border-radius: 14rpx; color: #fff; background: #16805c; font-size: 28rpx; }.profile-row { display: flex; align-items: center; text-align: left; }.profile-main { margin-left: 24rpx; }.nickname { font-size: 36rpx; font-weight: 700; }.profile-hint { margin-top: 10rpx; color: #899691; font-size: 23rpx; }.form-label { margin-top: 48rpx; color: #53635d; font-size: 24rpx; text-align: left; }.input { margin-top: 14rpx; padding: 20rpx; border: 1rpx solid #e2eae6; border-radius: 12rpx; text-align: left; }.logout-button { margin-top: 20rpx; border-radius: 14rpx; color: #687873; background: #edf3f0; font-size: 27rpx; }.error { margin-top: 22rpx; color: #d05b4e; font-size: 24rpx; }
