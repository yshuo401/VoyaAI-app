page{background:#f5f8fb;color:#1f2d3d}.page{min-height:100vh;padding:42rpx 30rpx 60rpx}.profile-card{padding:34rpx 28rpx 28rpx;border-radius:20rpx;background:#fff;box-shadow:0 10rpx 24rpx rgba(31,45,61,.07)}.profile-row{display:flex;align-items:center}.avatar-button{width:112rpx;height:112rpx;padding:0;border-radius:50%;background:transparent}.avatar-button::after{border:0}.avatar{width:112rpx;height:112rpx;border-radius:50%}.placeholder{display:flex;align-items:center;justify-content:center;color:#1677ff;background:#e7f1ff;font-size:42rpx;font-weight:700}.profile-main{margin-left:22rpx}.nickname{font-size:34rpx;font-weight:700}.profile-hint{margin-top:10rpx;color:#95a1ad;font-size:22rpx}.edit{margin-left:auto;color:#1677ff;font-size:30rpx}.login-button,.save-button{margin-top:28rpx;border-radius:32rpx;color:#fff;background:#1677ff;font-size:26rpx}.profile-edit{margin-top:22rpx}.input{padding:18rpx 20rpx;border:1rpx solid #e2eaf2;border-radius:12rpx;font-size:25rpx}.save-button{margin-top:18rpx}.stats{display:flex;justify-content:space-around;margin-top:20rpx;padding:30rpx 0;border-radius:18rpx;background:#fff;box-shadow:0 8rpx 20rpx rgba(31,45,61,.05)}.stats view{display:flex;flex-direction:column;align-items:center;gap:10rpx}.stats view text:first-child{color:#1677ff;font-size:34rpx;font-weight:700}.stats view text:last-child{color:#84919d;font-size:21rpx}.menu{margin-top:20rpx;padding:0 24rpx;border-radius:18rpx;background:#fff}.menu-item{display:flex;align-items:center;height:94rpx;border-bottom:1rpx solid #f0f3f6;font-size:27rpx}.menu-item:last-child{border:0}.menu-icon{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;margin-right:22rpx;border-radius:14rpx;color:#fff;font-size:26rpx}.menu-icon.blue{background:#4e8dff}.menu-icon.orange{background:#ffad35}.menu-icon.green{background:#31c49b}.menu-icon.purple{background:#8c74ed}.arrow{margin-left:auto;color:#a3afb9;font-size:36rpx}.logout-button{margin-top:28rpx;color:#e66b62;background:#fff;border-radius:30rpx;font-size:25rpx}.error{margin-top:16rpx;color:#e66b62;text-align:center;font-size:22rpx}
