page { background:#fff;color:#1f2d3d }.page{min-height:100vh;padding:24rpx 32rpx}.search-top{display:flex;align-items:center;gap:16rpx;padding-top:18rpx}.back{font-size:60rpx;color:#1f2d3d;line-height:42rpx}.search-box{display:flex;align-items:center;flex:1;height:76rpx;padding:0 20rpx;border-radius:40rpx;background:#f5f7fa;color:#1677ff}.search-box input{flex:1;margin-left:14rpx;color:#1f2d3d;font-size:25rpx}.clear{color:#9aa6b2;font-size:34rpx}.search-action{color:#1677ff;font-size:26rpx}.block{margin-top:48rpx}.block-head{display:flex;justify-content:space-between;font-size:29rpx;font-weight:700}.muted{color:#a4afb9;font-size:22rpx;font-weight:400}.chips{display:flex;flex-wrap:wrap;gap:18rpx;margin-top:22rpx}.chip{padding:14rpx 24rpx;border-radius:28rpx;background:#f4f7fa;color:#647383;font-size:22rpx}.chip.hot{color:#1677ff;background:#edf5ff}.chip-wrap{display:flex;align-items:center;gap:6rpx}.chip-del{display:flex;align-items:center;justify-content:center;width:30rpx;height:30rpx;color:#a4afb9;font-size:26rpx}.empty{margin-top:22rpx;color:#a4afb9;font-size:23rpx}.results{margin-top:20rpx}.result{display:flex;align-items:center;gap:18rpx;padding:16rpx 0;border-bottom:1rpx solid #eef1f4}.result image{width:90rpx;height:70rpx;border-radius:10rpx}.result>view{display:flex;flex-direction:column;gap:10rpx;font-size:25rpx}.result-sub{color:#99a5b0;font-size:21rpx}
