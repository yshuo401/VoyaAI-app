<view class="page"><view class="search-top"><text class="back" bindtap="goBack">‹</text><view class="search-box"><text>⌕</text><input focus value="{{keyword}}" placeholder="搜索城市、景点、攻略" confirm-type="search" bindinput="onInput" bindconfirm="search" /><text wx:if="{{keyword}}" class="clear" bindtap="clear">×</text></view><text class="search-action" bindtap="search">搜索</text></view><view class="block"><view class="block-head"><text>搜索历史</text><text class="muted" bindtap="clearHistory">清空</text></view><view class="chips"><text class="chip" wx:for="{{history}}" wx:key="*this" data-key="{{item}}" bindtap="useKeyword">{{item}}</text></view></view><view class="block"><view class="block-head"><text>热门搜索</text></view><view class="chips"><text class="chip hot" wx:for="{{hotWords}}" wx:key="*this" data-key="{{item}}" bindtap="useKeyword">{{item}}</text></view></view><view class="block"><view class="block-head"><text>大家都在搜</text></view><view class="results"><view class="result" wx:for="{{results}}" wx:key="id" data-city="{{item}}" bindtap="openCity"><image src="{{item.coverUrl}}" mode="aspectFill" /><view><text>{{item.name}}景点攻略</text><text class="result-sub">热门目的地 · 景点 · 美食</text></view></view></view></view></view>
