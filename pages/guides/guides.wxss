page{background:#f5f8fb;color:#1f2d3d}.page{min-height:100vh;padding:30rpx 32rpx}.title-row{display:flex;justify-content:space-between;align-items:center;padding:30rpx 4rpx 24rpx}.kicker{color:#1677ff;font-size:20rpx;letter-spacing:3rpx}.title{margin-top:12rpx;font-size:44rpx;font-weight:700}.search-icon{color:#1677ff;font-size:42rpx}.tabs{display:flex;gap:48rpx;padding:18rpx 4rpx 14rpx;border-bottom:1rpx solid #e6edf3}.tab{padding-bottom:14rpx;color:#8e9aa6;font-size:27rpx}.tab.active{color:#1677ff;font-weight:700;border-bottom:5rpx solid #1677ff}.regions{display:flex;white-space:nowrap;padding:22rpx 0}.region{display:inline-block;margin-right:16rpx;padding:12rpx 24rpx;border-radius:24rpx;color:#71808f;background:#fff;font-size:22rpx}.region.active{color:#fff;background:#1677ff}.guide{display:flex;overflow:hidden;margin-bottom:20rpx;border-radius:16rpx;background:#fff;box-shadow:0 8rpx 20rpx rgba(31,45,61,.06)}.guide image{width:220rpx;height:190rpx}.guide-content{flex:1;padding:22rpx 20rpx}.guide-title{font-size:27rpx;font-weight:700;line-height:1.4}.tags{display:flex;gap:10rpx;margin-top:18rpx}.tags text{padding:6rpx 12rpx;color:#1677ff;background:#edf5ff;border-radius:8rpx;font-size:18rpx}.guide-bottom{display:flex;gap:18rpx;margin-top:26rpx;color:#97a3ae;font-size:20rpx}.guide-bottom .city{margin-left:auto;color:#1677ff}.empty{padding:150rpx 0;text-align:center;color:#9aa6b2}
