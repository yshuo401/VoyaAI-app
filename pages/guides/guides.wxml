<view class="page">
  <view class="title-row"><view><view class="kicker">VOYAAI DISCOVER</view><view class="title">旅游攻略</view></view></view>
  <view class="search-box"><input value="{{keyword}}" maxlength="100" placeholder="搜索攻略" bindinput="onKeyword" bindconfirm="search" confirm-type="search" /><button size="mini" bindtap="search">搜索</button></view>
  <view class="tabs"><text wx:for="{{tabs}}" wx:key="key" class="tab {{sort === item.key ? 'active' : ''}}" data-sort="{{item.key}}" bindtap="chooseSort">{{item.name}}</text></view>
  <view class="filter-row"><picker range="{{cities}}" range-key="name" value="{{cityIndex}}" bindchange="chooseCity"><view>{{cities[cityIndex].name || '全部城市'}} ▾</view></picker><input value="{{guideType}}" maxlength="50" placeholder="攻略类型，例如自由行" bindinput="onType" bindconfirm="search" /></view>
  <view wx:if="{{cityError}}" class="feedback" bindtap="loadCities">{{cityError}}</view>
  <view class="guide" wx:for="{{guides}}" wx:key="id" data-id="{{item.id}}" bindtap="openGuide"><image src="{{item.image}}" mode="aspectFill" /><view class="guide-content"><view class="guide-title">{{item.title}}</view><view class="tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view><view class="guide-bottom"><text>◷ {{item.viewCount}}</text><text>♡ {{item.likeCount}}</text><text class="city">{{item.cityName}}</text></view></view></view>
  <view wx:if="{{loading}}" class="feedback">正在加载...</view>
  <view wx:elif="{{error}}" class="feedback" bindtap="retry">{{error}}，点击重试</view>
  <view wx:elif="{{!guides.length}}" class="empty">暂无符合条件的已发布攻略</view>
  <view wx:elif="{{guides.length >= total}}" class="feedback">已显示全部攻略</view>
</view>
