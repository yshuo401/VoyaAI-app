page{background:#f5f8fb;color:#1f2d3d}.page{min-height:100vh;padding:30rpx 32rpx}.empty{margin-top:160rpx;text-align:center;color:#8593a0;font-size:28rpx}.empty-icon{display:flex;align-items:center;justify-content:center;width:120rpx;height:120rpx;margin:0 auto 26rpx;border-radius:50%;color:#1677ff;background:#e7f1ff;font-size:52rpx}.empty button{width:220rpx;margin-top:36rpx;color:#fff;background:#1677ff;border-radius:32rpx;font-size:25rpx}.state{padding:100rpx 0;color:#8997a3;text-align:center;font-size:24rpx}.error{color:#e66b62}.list{display:flex;flex-direction:column;gap:18rpx}.card{display:flex;align-items:center;gap:20rpx;padding:18rpx;border-radius:16rpx;background:#fff;box-shadow:0 6rpx 18rpx rgba(31,45,61,.05)}.cover{width:130rpx;height:96rpx;border-radius:10rpx;background:#e7f1ff;flex-shrink:0}.main{flex:1;min-width:0}.tag{display:inline-block;padding:4rpx 12rpx;color:#1677ff;background:#edf5ff;border-radius:8rpx;font-size:18rpx}.title{margin-top:10rpx;font-size:27rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.time{margin-top:8rpx;color:#9aa6b2;font-size:20rpx}.remove{color:#e66b62;font-size:22rpx}
