page{background:#f5f8fb;color:#1f2d3d}.page{min-height:100vh;padding:24rpx 32rpx}.top{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0}.back{font-size:60rpx;line-height:40rpx}.title{font-size:34rpx;font-weight:700}.manage{color:#1677ff;font-size:36rpx}.search{display:flex;align-items:center;height:76rpx;padding:0 22rpx;border-radius:38rpx;background:#fff;color:#1677ff}.search input{flex:1;margin-left:14rpx;font-size:25rpx}.letters{display:flex;flex-wrap:wrap;gap:18rpx;padding:28rpx 0 14rpx;color:#1677ff;font-size:22rpx}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20rpx}.city{position:relative;overflow:hidden;height:220rpx;border-radius:16rpx;background:#dbe8f1}.city image{width:100%;height:100%}.shade{position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(9,28,50,.78))}.city text{position:absolute;left:20rpx;bottom:18rpx;color:#fff;font-size:29rpx;font-weight:700}.empty{padding:120rpx;text-align:center;color:#95a3af}
