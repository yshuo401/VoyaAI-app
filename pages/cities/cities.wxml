<view class="page"><view class="top"><text class="back" bindtap="goBack">‹</text><text class="title">热门城市</text><text class="manage">⌕</text></view><view class="search"><text>⌕</text><input value="{{keyword}}" placeholder="搜索城市" bindinput="onInput" /></view><view class="letters"><text wx:for="{{letters}}" wx:key="*this">{{item}}</text></view><view class="grid"><view class="city" wx:for="{{cities}}" wx:key="id" data-city="{{item}}" bindtap="openCity"><image src="{{item.coverUrl}}" mode="aspectFill" /><view class="shade"></view><text>{{item.name}}</text></view></view><view wx:if="{{!cities.length}}" class="empty">暂无匹配城市</view></view>
