<view class="page">
  <view class="topbar"><view class="location" bindtap="openCities"><text class="pin">⌖</text><text>{{currentCity}}</text><text class="chevron">⌄</text></view><view class="weather">☼ {{weather}}</view></view>
  <view class="hero"><image src="/assets/hero.jpg" mode="aspectFill" /><view class="hero-mask"></view><view class="hero-copy"><view class="hero-title">去看更大的世界</view><view class="hero-subtitle">用 AI 规划你的专属旅行</view></view><view class="hero-search" bindtap="openSearch"><text class="search-icon">⌕</text><text>搜索目的地、攻略、景点...</text></view></view>
  <view class="quick-grid">
    <view class="quick-item" wx:for="{{quickItems}}" wx:key="title" data-key="{{item.key}}" bindtap="onQuick"><view class="quick-icon {{item.color}}">{{item.icon}}</view><text>{{item.title}}</text></view>
  </view>
  <view class="section-head"><text class="section-title">热门目的地</text><text class="more" bindtap="openCities">查看更多 ›</text></view>
  <scroll-view class="city-scroll" scroll-x enable-flex>
    <view class="city-card" wx:for="{{cities}}" wx:key="id" data-city="{{item}}" bindtap="openCity"><image src="{{item.coverUrl}}" mode="aspectFill" /><view class="city-gradient"></view><text>{{item.name}}</text></view>
    <view wx:if="{{!cities.length && !loading}}" class="empty-card">暂无城市</view>
  </scroll-view>
  <view class="section-head guide-head"><text class="section-title">精选攻略</text><text class="more" bindtap="openGuides">查看更多 ›</text></view>
  <view class="guide-list"><view class="guide-card" wx:for="{{guides}}" wx:key="id" data-id="{{item.id}}" bindtap="openGuide"><image src="{{item.image}}" mode="aspectFill" /><view class="guide-body"><view class="guide-title">{{item.title}}</view><view class="guide-desc">{{item.summary}}</view><view class="guide-meta">◷ {{item.viewCount}} · ♡ {{item.likeCount}} <text>{{item.cityName}}</text></view></view></view></view>
  <view wx:if="{{guideLoading}}" class="loading">正在加载攻略...</view>
  <view wx:elif="{{guideError}}" class="error" bindtap="loadGuides">{{guideError}}，点击重试</view>
  <view wx:elif="{{!guides.length}}" class="loading">暂无已发布攻略</view>
  <view wx:if="{{loading}}" class="loading">正在加载目的地...</view><view wx:if="{{error}}" class="error" bindtap="loadCities">{{error}}，点击重试</view>
</view>
