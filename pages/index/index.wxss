page { background: #f5f8fb; }.page { padding-bottom: 40rpx; }.topbar { display: flex; justify-content: space-between; align-items: center; height: 84rpx; padding: 0 32rpx; box-sizing: border-box; background: #fff; }.location { display: flex; align-items: center; color: #1f2d3d; font-size: 28rpx; font-weight: 600; }.pin { margin-right: 8rpx; color: #1677ff; font-size: 34rpx; }.chevron { margin-left: 8rpx; color: #8a99a8; }.weather { color: #647383; font-size: 24rpx; }.hero { position: relative; height: 460rpx; overflow: hidden; }.hero image { width: 100%; height: 100%; }.hero-mask { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14,64,113,.05) 20%, rgba(15,51,83,.75) 100%); }.hero-copy { position: absolute; left: 38rpx; bottom: 108rpx; color: #fff; }.hero-title { font-size: 48rpx; font-weight: 700; letter-spacing: 2rpx; }.hero-subtitle { margin-top: 12rpx; font-size: 25rpx; opacity: .9; }.hero-search { position: absolute; left: 32rpx; right: 32rpx; bottom: 28rpx; display: flex; align-items: center; height: 76rpx; padding: 0 24rpx; box-sizing: border-box; border-radius: 40rpx; color: #8b99a5; background: #fff; font-size: 24rpx; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.14); }.search-icon { margin-right: 14rpx; color: #1677ff; font-size: 34rpx; }.quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28rpx 10rpx; padding: 30rpx 24rpx 22rpx; background: #fff; }.quick-item { display: flex; flex-direction: column; align-items: center; color: #4f5f6e; font-size: 22rpx; }.quick-icon { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; margin-bottom: 10rpx; border-radius: 18rpx; color: #fff; font-size: 32rpx; font-weight: 700; }.blue { background: #4e8dff; }.orange { background: #ffad35; }.green { background: #31c49b; }.red { background: #ff6868; }.sky { background: #43a7ef; }.purple { background: #8c74ed; }.cyan { background: #5bb9ef; }.section-head { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 30rpx 18rpx; }.section-title { color: #1f2d3d; font-size: 32rpx; font-weight: 700; }.more { color: #9aa6b2; font-size: 22rpx; }.city-scroll { display: flex; white-space: nowrap; padding: 0 30rpx 8rpx; }.city-card { position: relative; display: inline-block; overflow: hidden; width: 190rpx; height: 220rpx; margin-right: 18rpx; border-radius: 16rpx; background: #dce9f2; box-shadow: 0 8rpx 18rpx rgba(31,45,61,.1); }.city-card image { width: 100%; height: 100%; }.city-gradient { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 38%, rgba(7,25,42,.75)); }.city-card text { position: absolute; left: 20rpx; bottom: 18rpx; color: #fff; font-size: 28rpx; font-weight: 700; }.empty-card { padding: 70rpx; color: #9aa6b2; font-size: 24rpx; }.guide-head { padding-top: 36rpx; }.guide-list { padding: 0 30rpx; }.guide-card { display: flex; overflow: hidden; margin-bottom: 18rpx; min-height: 152rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 6rpx 18rpx rgba(31,45,61,.06); }.guide-card image { width: 190rpx; height: 152rpx; }.guide-body { flex: 1; padding: 18rpx 20rpx; }.guide-title { overflow: hidden; color: #293949; font-size: 27rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.guide-desc { margin-top: 14rpx; color: #84919d; font-size: 22rpx; }.guide-meta { margin-top: 22rpx; color: #9aa6b2; font-size: 20rpx; }.guide-meta text { float: right; color: #1677ff; }.loading,.error { padding: 22rpx; color: #8b99a5; text-align: center; font-size: 22rpx; }.error { color: #e66b62; }
