<view class="page">
  <view class="head"><text>最近浏览</text><text wx:if="{{items.length}}" class="clear" bindtap="clear">清空</text></view>
  <view wx:if="{{!loggedIn}}" class="empty"><view class="empty-icon">◷</view><view>登录后记录浏览历史</view><button bindtap="goLogin">去登录</button></view>
  <view wx:elif="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state error">{{error}}，点击重试</view>
  <view wx:elif="{{!items.length}}" class="empty"><view class="empty-icon">◷</view><view>暂无浏览记录</view></view>
  <view wx:else class="list"><view class="card" wx:for="{{items}}" wx:key="id" data-type="{{item.targetType}}" data-id="{{item.targetId}}" data-name="{{item.targetTitle}}" bindtap="open"><image class="cover" src="{{item.cover}}" mode="aspectFill" /><view class="main"><view class="tag">{{item.typeName}}</view><view class="title">{{item.targetTitle || ('目标 ' + item.targetId)}}</view><view class="time">{{item.createTime}}</view></view></view></view>
</view>
