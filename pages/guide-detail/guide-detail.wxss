page{background:#f5f8fb;color:#1f2d3d}.page{padding-bottom:60rpx}.hero{position:relative;height:440rpx}.hero image{width:100%;height:100%}.mask{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.15),rgba(0,0,0,.45))}.back{position:absolute;top:44rpx;left:28rpx;color:#fff;font-size:64rpx}.content{margin-top:-24rpx;position:relative;padding:32rpx;border-radius:24rpx 24rpx 0 0;background:#fff}.title{font-size:38rpx;font-weight:700}.tags{display:flex;gap:14rpx;margin-top:20rpx}.tags text{padding:10rpx 18rpx;border-radius:22rpx;color:#1677ff;background:#edf5ff;font-size:20rpx}.author{display:flex;align-items:center;margin-top:30rpx}.author-avatar{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:50%;color:#1677ff;background:#e7f1ff}.author>view:nth-child(2){margin-left:16rpx;font-size:25rpx}.date{margin-top:6rpx;color:#a0acb7;font-size:20rpx}.author button{margin-left:auto;padding:0 28rpx;color:#1677ff;background:#edf5ff;border-radius:24rpx;font-size:22rpx}.paragraph{margin-top:28rpx;color:#63717d;font-size:26rpx;line-height:1.7}.heading{margin-top:34rpx;font-size:30rpx;font-weight:700}.days{display:flex;gap:18rpx;margin-top:18rpx}.days text{padding:10rpx 24rpx;border-radius:24rpx;background:#f3f6f8;color:#8795a1;font-size:22rpx}.days .active{color:#fff;background:#1677ff}.timeline{margin-top:24rpx}.timeline-item{display:flex;gap:18rpx;padding:14rpx 0;margin-bottom:12rpx;border:1rpx solid #edf1f4;border-radius:14rpx}.timeline-item image{width:130rpx;height:96rpx;border-radius:10rpx}.spot{font-size:26rpx;font-weight:700}.time,.type{margin-top:8rpx;color:#8d9aa5;font-size:20rpx}.type{color:#1677ff}