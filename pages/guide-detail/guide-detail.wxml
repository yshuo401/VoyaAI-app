<view class="page">
  <view wx:if="{{loading}}" class="feedback">正在加载攻略...</view>
  <view wx:elif="{{error}}" class="feedback"><view>{{error}}</view><button bindtap="load">重试</button><button bindtap="back">返回攻略列表</button></view>
  <block wx:elif="{{detail}}"><view class="hero"><image src="{{detail.image}}" mode="aspectFill" /><view class="mask"></view><view class="back" bindtap="back">‹</view></view>
    <view class="content"><view class="title">{{detail.title}}</view><view class="tags"><text wx:for="{{detail.tags}}" wx:key="*this">{{item}}</text></view>
      <view class="metadata">{{detail.cityName}} · {{detail.guideType || '旅行攻略'}} · {{detail.days}} 天</view>
      <view class="metadata">预算 ¥{{detail.budgetMin}} — ¥{{detail.budgetMax}}</view>
      <view class="metadata">发布于 {{detail.publishTime}} · {{detail.viewCount}} 次浏览</view>
      <view wx:if="{{detail.summary}}" class="paragraph">{{detail.summary}}</view><view class="heading">攻略正文</view><text class="guide-body" selectable>{{detail.content}}</text>
      <view class="actions"><button class="{{favorited ? 'active' : ''}}" bindtap="toggleFavorite">{{favorited ? '★ 已收藏' : '☆ 收藏'}}</button><button class="{{liked ? 'active' : ''}}" bindtap="toggleLike">♥ {{likeCount || '点赞'}}</button></view>
    </view>
    <view class="comments">
      <view class="comments-head">评论 {{commentTotal ? commentTotal : ''}}</view>
      <view wx:if="{{replyTo}}" class="reply-hint">回复 @{{replyTo.name}} <text bindtap="cancelReply">取消</text></view>
      <view class="comment-input"><input value="{{commentText}}" maxlength="1000" placeholder="{{replyTo ? '回复 ' + replyTo.name : '说点什么...'}}" bindinput="onCommentInput" confirm-type="send" bindconfirm="submitComment" /><button size="mini" loading="{{submitting}}" bindtap="submitComment">发布</button></view>
      <view wx:if="{{commentLoading}}" class="comment-state">加载评论中...</view>
      <view wx:elif="{{!comments.length}}" class="comment-state">还没有评论，来抢沙发吧</view>
      <view class="comment" wx:for="{{comments}}" wx:key="id">
        <view class="comment-main"><image class="avatar" src="{{item.avatar}}" mode="aspectFill" /><view class="comment-body"><view class="comment-name">{{item.nickname || '旅行者'}}</view><view class="comment-content">{{item.content}}</view><view class="comment-meta"><text>{{item.createTime}}</text><text class="like {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" bindtap="toggleCommentLike">♥ {{item.likeCount || 0}}</text><text bindtap="replyTo" data-id="{{item.id}}" data-name="{{item.nickname || '旅行者'}}">回复</text></view></view></view>
        <view class="replies" wx:if="{{item.replies.length}}"><view class="reply" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id"><view class="reply-name">{{reply.nickname || '旅行者'}}</view><view class="reply-content">{{reply.content}}</view><view class="reply-meta"><text>{{reply.createTime}}</text><text class="like {{reply.liked ? 'liked' : ''}}" data-id="{{reply.id}}" bindtap="toggleCommentLike">♥ {{reply.likeCount || 0}}</text></view></view></view>
      </view>
    </view>
  </block>
</view>
