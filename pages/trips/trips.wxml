<view class="page"><view class="title-row"><view><view class="kicker">VOYAAI PLAN</view><view class="title">我的行程</view></view><text class="add">＋</text></view><view class="ai-card"><view class="ai-title">让 AI 帮你定制旅行</view><view class="ai-desc">告诉我你的目的地、天数和偏好，为你生成专属行程</view><button bindtap="startPlan">开始规划</button></view><view class="section-head"><text>我的行程</text><text class="muted">{{trips.length}} 个行程</text></view><view wx:if="{{!trips.length}}" class="empty"><view class="empty-icon">✈</view><view>还没有行程</view><view class="empty-sub">创建一份行程，记录你的每一次出发</view><button bindtap="startPlan">创建行程</button></view><view wx:else class="trip-list"><view class="trip" wx:for="{{trips}}" wx:key="id"><image src="{{item.image}}" mode="aspectFill" /><view><view class="trip-title">{{item.title}}</view><view class="trip-date">{{item.date}}</view></view></view></view></view>
