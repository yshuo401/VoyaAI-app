page{background:#f5f8fb;color:#1f2d3d}.page{min-height:100vh;padding:30rpx 32rpx}.title-row{display:flex;justify-content:space-between;align-items:center;padding:30rpx 4rpx 34rpx}.kicker{color:#1677ff;font-size:20rpx;letter-spacing:3rpx}.title{margin-top:12rpx;font-size:44rpx;font-weight:700}.add{color:#1677ff;font-size:42rpx}.ai-card{padding:30rpx;border-radius:18rpx;background:linear-gradient(130deg,#1677ff,#69b5ff);color:#fff;box-shadow:0 12rpx 24rpx rgba(22,119,255,.23)}.ai-title{font-size:34rpx;font-weight:700}.ai-desc{margin-top:12rpx;opacity:.88;font-size:23rpx;line-height:1.5}.ai-card button{width:190rpx;margin:26rpx 0 0;padding:0;border-radius:28rpx;color:#1677ff;background:#fff;font-size:24rpx}.section-head{display:flex;justify-content:space-between;margin-top:44rpx;font-size:30rpx;font-weight:700}.muted{color:#9aa6b2;font-size:22rpx;font-weight:400}.empty{margin-top:100rpx;text-align:center;color:#8593a0;font-size:28rpx}.empty-icon{display:flex;align-items:center;justify-content:center;width:120rpx;height:120rpx;margin:0 auto 26rpx;border-radius:50%;color:#1677ff;background:#e7f1ff;font-size:56rpx}.empty-sub{margin-top:14rpx;color:#a4afb9;font-size:23rpx}.empty button{width:240rpx;margin-top:38rpx;color:#fff;background:#1677ff;border-radius:34rpx;font-size:26rpx}.trip{display:flex;margin-top:18rpx;padding:16rpx;border-radius:16rpx;background:#fff}.trip image{width:170rpx;height:120rpx;border-radius:10rpx}.trip>view{padding:12rpx 18rpx}.trip-title{font-size:28rpx;font-weight:700}.trip-date{margin-top:16rpx;color:#94a0ac;font-size:22rpx}
