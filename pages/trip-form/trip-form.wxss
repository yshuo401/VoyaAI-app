page{background:#f5f8fb;color:#1f2d3d}.page{min-height:100vh;padding:30rpx 32rpx 80rpx}.form-card{padding:8rpx 28rpx;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(31,45,61,.06)}.field{padding:26rpx 0;border-bottom:1rpx solid #f0f3f6}.field:last-child{border:0}.label{color:#536575;font-size:23rpx;font-weight:700}.value{width:100%;margin-top:12rpx;font-size:27rpx}.value.placeholder{color:#a4afb9}.textarea{height:180rpx;line-height:1.5}.save{margin-top:36rpx;color:#fff;background:#1677ff;border-radius:34rpx;font-size:27rpx}
