<view class="page" wx:if="{{detail}}">
  <view class="top"><text class="back" bindtap="back">‹</text><view class="head-main"><view class="title">{{detail.title}}</view><view class="date">{{detail.startDate || '未设置'}} ~ {{detail.endDate || '未设置'}} · {{detail.peopleCount}}人 · {{detail.cityName}}</view></view><view class="head-actions"><text bindtap="editTrip">编辑</text><text bindtap="share">分享</text><text class="danger" bindtap="deleteTrip">删除</text></view></view>
  <view class="meta"><text>{{detail.travelType || '自由行'}}</text><text>预算 ¥{{detail.budget}}</text><text>{{detail.days.length}} 天</text></view>
  <view wx:if="{{detail.description}}" class="desc">{{detail.description}}</view>
  <view class="section-head"><text>行程安排</text><text class="add-day" bindtap="openAddDay">＋ 添加天数</text></view>
  <view wx:if="{{!detail.days.length}}" class="empty">还没有行程日，先添加第一天吧</view>
  <view class="day" wx:for="{{detail.days}}" wx:key="id">
    <view class="day-head"><view class="day-title">Day {{item.dayNumber}} <text>{{item.date || ''}}</text></view><view class="day-actions"><text bindtap="openEditDay" data-day="{{item}}">编辑</text><text class="danger" bindtap="deleteDay" data-day="{{item}}">删除</text></view></view>
    <view wx:if="{{item.title}}" class="day-name">{{item.title}}</view>
    <view wx:if="{{item.description}}" class="day-desc">{{item.description}}</view>
    <view class="item" wx:for="{{item.items}}" wx:for-item="it" wx:key="id"><view class="item-time">{{it.startTime || '—'}}</view><view class="item-main"><view class="item-title">{{it.title}}</view><view class="item-sub">{{itemTypeLabel(it.itemType)}}<text wx:if="{{it.address}}"> · {{it.address}}</text></view></view><view class="item-actions"><text bindtap="openEditItem" data-item="{{it}}">编辑</text><text class="danger" bindtap="deleteItem" data-item="{{it}}">删除</text></view></view>
    <view class="add-item" data-day-id="{{item.id}}" bindtap="openAddItem">＋ 添加行程项</view>
  </view>
</view>
<view wx:elif="{{loading}}" class="state">正在加载行程...</view>
<view wx:else class="state error">{{error || '行程不存在'}}</view>

<view class="modal" wx:if="{{dayEditor}}"><view class="mask" bindtap="closeDayEditor"></view><view class="sheet"><view class="sheet-title">行程日</view><view class="sheet-row"><input type="number" value="{{dayEditor.dayNumber}}" data-key="dayNumber" bindinput="onDay" placeholder="第几天" /></view><view class="sheet-row"><picker mode="date" value="{{dayEditor.date}}" bindchange="onDay"><view>{{dayEditor.date || '选择日期'}}</view></picker></view><view class="sheet-row"><input value="{{dayEditor.title}}" data-key="title" bindinput="onDay" placeholder="当天标题（可选）" /></view><view class="sheet-row"><textarea value="{{dayEditor.description}}" data-key="description" bindinput="onDay" placeholder="当天描述（可选）" /></view><view class="sheet-buttons"><button bindtap="closeDayEditor">取消</button><button class="primary" bindtap="saveDay">保存</button></view></view></view>

<view class="modal" wx:if="{{itemEditor}}"><view class="mask" bindtap="closeItemEditor"></view><view class="sheet"><view class="sheet-title">行程项</view><view class="sheet-row"><picker range="{{itemTypes}}" range-key="label" value="{{itemTypeIndex}}" bindchange="onItemType"><view>{{itemTypes[itemTypeIndex].label}}</view></picker></view><view class="sheet-row"><input value="{{itemEditor.title}}" data-key="title" bindinput="onItem" placeholder="项目名称" /></view><view class="sheet-row two"><input value="{{itemEditor.startTime}}" data-key="startTime" bindinput="onItem" placeholder="开始 HH:mm" /><input value="{{itemEditor.endTime}}" data-key="endTime" bindinput="onItem" placeholder="结束 HH:mm" /></view><view class="sheet-row"><input value="{{itemEditor.address}}" data-key="address" bindinput="onItem" placeholder="地址（可选）" /></view><view class="sheet-row"><input type="digit" value="{{itemEditor.estimatedCost}}" data-key="estimatedCost" bindinput="onItem" placeholder="预估费用（可选）" /></view><view class="sheet-buttons"><button bindtap="closeItemEditor">取消</button><button class="primary" bindtap="saveItem">保存</button></view></view></view>
