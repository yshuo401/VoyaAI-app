page{background:#f5f8fb;color:#1f2d3d}.page{padding:28rpx 32rpx}.top{display:flex;align-items:center;gap:18rpx;padding:24rpx 0}.back{font-size:60rpx}.title{font-size:34rpx;font-weight:700}.date{margin-top:8rpx;color:#8b99a5;font-size:21rpx}.edit{margin-left:auto;color:#1677ff;font-size:30rpx}.days{display:flex;gap:10rpx;overflow:hidden;padding:20rpx 0}.days text{white-space:nowrap;padding:12rpx 18rpx;border-radius:20rpx;color:#8795a1;background:#fff;font-size:21rpx}.days .active{color:#fff;background:#1677ff}.day{margin-top:24rpx}.day-title{font-size:30rpx;font-weight:700}.day-title text{margin-left:16rpx;color:#9aa6b2;font-size:21rpx;font-weight:400}.item{display:flex;gap:18rpx;margin-top:16rpx;padding:14rpx;border-radius:14rpx;background:#fff;box-shadow:0 5rpx 16rpx rgba(31,45,61,.05)}.item image{width:110rpx;height:80rpx;border-radius:8rpx}.item>view{padding-top:8rpx;font-size:25rpx}.item text{display:block;margin-top:10rpx;color:#8b99a5;font-size:20rpx}