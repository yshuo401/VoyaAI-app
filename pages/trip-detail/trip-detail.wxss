page{background:#f5f8fb;color:#1f2d3d}.page{padding:28rpx 32rpx 80rpx}.top{display:flex;align-items:center;gap:18rpx;padding:24rpx 0}.back{font-size:60rpx}.head-main{flex:1;min-width:0}.title{font-size:34rpx;font-weight:700}.date{margin-top:8rpx;color:#8b99a5;font-size:21rpx}.head-actions{display:flex;gap:22rpx;color:#1677ff;font-size:24rpx}.head-actions .danger{color:#e66b62}.meta{display:flex;gap:24rpx;margin-top:18rpx;color:#1677ff;font-size:22rpx}.desc{margin-top:16rpx;color:#63717d;font-size:24rpx;line-height:1.6}.section-head{display:flex;justify-content:space-between;align-items:center;margin-top:36rpx;font-size:30rpx;font-weight:700}.add-day{color:#1677ff;font-size:24rpx;font-weight:400}.empty{margin-top:60rpx;color:#9aa6b2;text-align:center;font-size:24rpx}.day{margin-top:24rpx;padding:22rpx;border-radius:16rpx;background:#fff;box-shadow:0 5rpx 16rpx rgba(31,45,61,.05)}.day-head{display:flex;justify-content:space-between;align-items:center}.day-title{font-size:28rpx;font-weight:700}.day-title text{margin-left:12rpx;color:#9aa6b2;font-size:21rpx;font-weight:400}.day-actions{display:flex;gap:20rpx;color:#1677ff;font-size:22rpx}.day-actions .danger{color:#e66b62}.day-name{margin-top:12rpx;font-size:25rpx}.day-desc{margin-top:8rpx;color:#8b99a5;font-size:22rpx}.item{display:flex;align-items:center;margin-top:16rpx;padding:18rpx;border-radius:12rpx;background:#f7f9fb}.item-time{width:110rpx;color:#1677ff;font-size:22rpx}.item-main{flex:1;min-width:0}.item-title{font-size:26rpx;font-weight:600}.item-sub{margin-top:8rpx;color:#8b99a5;font-size:20rpx}.item-actions{display:flex;gap:18rpx;color:#1677ff;font-size:21rpx}.item-actions .danger{color:#e66b62}.add-item{margin-top:16rpx;padding:16rpx;border:1rpx dashed #c8d6e5;border-radius:12rpx;color:#1677ff;text-align:center;font-size:23rpx}.state{padding:120rpx 40rpx;color:#8997a3;text-align:center}.error{color:#e66b62}
